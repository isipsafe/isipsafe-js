{
  "name": "isipsafe",
  "version": "0.1.0",
  "description": "Official JavaScript/TypeScript client and CLI for isIPsafe: check IP reputation, report abusive IPs and download firewall blocklists.",
  "keywords": [
    "isipsafe",
    "ip reputation",
    "abuse",
    "blocklist",
    "threat intelligence",
    "security",
    "firewall",
    "abuseipdb",
    "ip lookup"
  ],
  "homepage": "https://isipsafe.com",
  "bugs": "https://github.com/isipsafe/isipsafe-js/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isipsafe/isipsafe-js.git"
  },
  "license": "MIT",
  "author": "WaveCentric <sasi@wavecentric.ai>",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "isipsafe": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:package",
    "check:package": "publint && attw --pack . --ignore-rules cjs-resolves-to-esm",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.12",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
